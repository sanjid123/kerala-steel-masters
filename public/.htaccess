# PS Steels & Engineering - Hostinger Apache config
# Drop this in public_html alongside the site files.

# ----------------------------------------------------------------------
# 1. Force HTTPS + non-www (canonical: https://pssteels.in)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www -> non-www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # ------------------------------------------------------------------
  # 2. Pretty URLs: serve /services from /services/index.html, etc.
  # ------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]

  # SPA fallback — anything else falls back to /index.html
  # (also lets client-side router handle deep links not in the prerender list)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
  RewriteRule . /index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# 3. Custom 404
# ----------------------------------------------------------------------
ErrorDocument 404 /index.html

# ----------------------------------------------------------------------
# 4. Compression (Gzip + Brotli when available)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript \
    application/javascript application/json application/xml \
    application/rss+xml application/atom+xml image/svg+xml \
    font/ttf font/otf application/font-woff application/font-woff2
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# 5. Cache headers
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Hashed assets — safe to cache forever
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML — short cache, must revalidate
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>

  # XML / robots
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
</IfModule>

# ----------------------------------------------------------------------
# 6. Security headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ----------------------------------------------------------------------
# 7. Correct MIME types
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType application/xml .xml
</IfModule>

# ----------------------------------------------------------------------
# 8. Disallow listing directories
# ----------------------------------------------------------------------
Options -Indexes
